rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{id} { allow read: if true; allow write: if request.auth != null; }
    match /settings/{id} { allow read: if true; allow write: if request.auth != null; }
    match /codes/{id}    { allow read: if true; allow write: if request.auth != null; }
    match /orders/{id}   { allow create, get: if true; allow list, update, delete: if request.auth != null; }
  }
}
